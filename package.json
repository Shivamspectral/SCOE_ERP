{
  "name": "astra-plus-campus",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "pnpm --filter @astra-campus/web dev",
    "dev:api": "pnpm --filter @astra-campus/api dev",
    "build": "pnpm --filter @astra-campus/web build",
    "build:api": "pnpm --filter @astra-campus/api build",
    "typecheck": "pnpm --filter @astra-campus/web typecheck && pnpm --filter @astra-campus/api typecheck",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new"
  },
  "dependencies": {},
  "devDependencies": {},
  "description": "Astra+ Campus - workflow-first college management system",
  "engines": {
    "node": ">=22.12.0"
  }
}
