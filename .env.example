# Optional while developing the prototype. If both Supabase values are absent,
# the app automatically uses demo login mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set true to force the entire app into demo mode even if Supabase credentials are configured.
NEXT_PUBLIC_DEMO_MODE=false

# Optional: show demo accounts alongside real Supabase login on a live deployment.
# Set all three variables only when you intentionally want public demo access.
NEXT_PUBLIC_DEMO_LOGIN_ENABLED=false
DEMO_LOGIN_ENABLED=false
# Generate a private random secret of at least 32 characters. Never prefix it with NEXT_PUBLIC_.
DEMO_LOGIN_SECRET=
