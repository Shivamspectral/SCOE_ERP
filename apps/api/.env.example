NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Never commit service-role keys, database passwords, or signing secrets.
# API forwards each authenticated user's JWT so Supabase RLS remains enforced.
# No service-role key is needed by the request-scoped data adapter.

# Optional: required only for staff invitation emails; server-side secret, never expose to Vite.
SUPABASE_SERVICE_ROLE_KEY=
